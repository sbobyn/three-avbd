{
  "name": "three-avbd",
  "version": "0.4.0",
  "description": "GPU rigid-body physics for Three.js (WebGPU): Augmented Vertex Block Descent with joints, convex shapes and experimental non-convex SDF collisions.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "three",
    "threejs",
    "webgpu",
    "physics",
    "rigid-body",
    "collision",
    "raycast",
    "avbd",
    "gpu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbobyn/three-avbd.git"
  },
  "homepage": "https://github.com/sbobyn/three-avbd#readme",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js"
    },
    "./sdf": {
      "types": "./build/lib/sdf.d.ts",
      "import": "./build/lib/sdf.js"
    },
    "./queries": {
      "types": "./build/lib/queries.d.ts",
      "import": "./build/lib/queries.js"
    },
    "./advanced": {
      "types": "./build/lib/advanced.d.ts",
      "import": "./build/lib/advanced.js"
    }
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "three": ">=0.186.0"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5317 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm test:gpu && pnpm build && pnpm build:lib",
    "bench2d": "node --experimental-transform-types --no-warnings scripts/bench2d.ts",
    "fetch-reference": "sh scripts/fetch-reference.sh",
    "test:gpu": "node --experimental-transform-types --test tests-gpu/*.gpu.test.ts",
    "bench2d:gpu": "node --experimental-transform-types --no-warnings scripts/bench2d-gpu.ts",
    "bench3d:gpu": "node --experimental-transform-types --no-warnings scripts/bench3d-gpu.ts",
    "sweep2d": "node --experimental-transform-types --no-warnings scripts/sweep2d.ts",
    "scaling2d": "node --experimental-transform-types --no-warnings scripts/scaling2d.ts",
    "build:lib": "rm -rf build && tsc -p tsconfig.lib.json",
    "prepublishOnly": "pnpm check",
    "compare:rapier": "node --experimental-transform-types --no-warnings scripts/compare-rapier.ts"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@types/node": "^25.0.0",
    "@types/three": "0.187.0",
    "@webgpu/types": "^0.1.74",
    "three": "0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "webgpu": "0.6.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "webgpu"
    ]
  }
}
